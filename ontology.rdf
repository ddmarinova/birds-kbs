<?xml version="1.0"?>
<rdf:RDF xmlns="http://birds.ontology"
     xml:base="http://birds.ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:birds="http://birds.ontology#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://birds.ontology">
        <owl:versionIRI rdf:resource="http://birds.ontology/1.0.0"/>
        <rdfs:comment xml:lang="bg">Онтология за представяне на знания за птици в България. Включва таксономична класификация, морфология, хранителни навици, местообитания и природозащитен статус. Данни от Българското дружество за защита на птиците - БДЗП (birdlife.bg).</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://birds.ontology#belongsToSpecies -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#belongsToSpecies">
        <owl:inverseOf rdf:resource="http://birds.ontology#isSpeciesOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Bird"/>
        <rdfs:range rdf:resource="http://birds.ontology#Species"/>
        <rdfs:label xml:lang="en">Belongs to species</rdfs:label>
        <rdfs:label xml:lang="bg">Принадлежи към вид</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#foundInRegion -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#foundInRegion">
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:label xml:lang="en">Found in region</rdfs:label>
        <rdfs:label xml:lang="bg">Среща се в регион</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasBeakMorphology -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasBeakMorphology">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#BeakMorphology"/>
        <rdfs:label xml:lang="en">Has beak morphology</rdfs:label>
        <rdfs:label xml:lang="bg">Има морфология на клюна</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasBreedingSeason -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasBreedingSeason">
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#Season"/>
        <rdfs:label xml:lang="en">Has breeding season</rdfs:label>
        <rdfs:label xml:lang="bg">Има размножителен сезон</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasGender -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasGender">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Bird"/>
        <rdfs:range rdf:resource="http://birds.ontology#Gender"/>
        <rdfs:label xml:lang="en">Has gender</rdfs:label>
        <rdfs:label xml:lang="bg">Има пол</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasIUCNStatus -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasIUCNStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#IUCNStatus"/>
        <rdfs:label xml:lang="en">Has IUCN status</rdfs:label>
        <rdfs:label xml:lang="bg">Има IUCN статус</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasLegMorphology -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasLegMorphology">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#LegMorphology"/>
        <rdfs:label xml:lang="en">Has leg morphology</rdfs:label>
        <rdfs:label xml:lang="bg">Има морфология на краката</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasLifeStage -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasLifeStage">
        <rdfs:domain rdf:resource="http://birds.ontology#Bird"/>
        <rdfs:range rdf:resource="http://birds.ontology#LifeStage"/>
        <rdfs:label xml:lang="en">Has life stage</rdfs:label>
        <rdfs:label xml:lang="bg">Има жизнен стадий</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasMeasurement -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasMeasurement">
        <rdfs:domain rdf:resource="http://birds.ontology#Observation"/>
        <rdfs:range rdf:resource="http://birds.ontology#Measurement"/>
        <rdfs:label xml:lang="en">Has measurement</rdfs:label>
        <rdfs:label xml:lang="bg">Има измерване</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasMigratoryBehaviour -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasMigratoryBehaviour">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#MigratoryBehaviour"/>
        <rdfs:label xml:lang="en">Has migratory behaviour</rdfs:label>
        <rdfs:label xml:lang="bg">Има миграционно поведение</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasObservation -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasObservation">
        <owl:inverseOf rdf:resource="http://birds.ontology#observedBird"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Bird"/>
        <rdfs:range rdf:resource="http://birds.ontology#Observation"/>
        <rdfs:label xml:lang="en">Has observation</rdfs:label>
        <rdfs:label xml:lang="bg">Има наблюдение</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasObservedBehavior -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasObservedBehavior">
        <rdfs:domain rdf:resource="http://birds.ontology#Observation"/>
        <rdfs:range rdf:resource="http://birds.ontology#Behavior"/>
        <rdfs:label xml:lang="en">Has observed behavior</rdfs:label>
        <rdfs:label xml:lang="bg">Има наблюдавано поведение</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasObservedDiet -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasObservedDiet">
        <rdfs:domain rdf:resource="http://birds.ontology#Observation"/>
        <rdfs:range rdf:resource="http://birds.ontology#Diet"/>
        <rdfs:label xml:lang="en">Has observed diet</rdfs:label>
        <rdfs:label xml:lang="bg">Има наблюдавана храна</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasObservedHabitat -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasObservedHabitat">
        <rdfs:domain rdf:resource="http://birds.ontology#Observation"/>
        <rdfs:range rdf:resource="http://birds.ontology#Habitat"/>
        <rdfs:label xml:lang="en">Has observed habitat</rdfs:label>
        <rdfs:label xml:lang="bg">Има наблюдавано местообитание</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasObservedPlumagePattern -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasObservedPlumagePattern">
        <rdfs:domain rdf:resource="http://birds.ontology#Observation"/>
        <rdfs:range rdf:resource="http://birds.ontology#PlumagePattern"/>
        <rdfs:label xml:lang="en">Has observed plumage pattern</rdfs:label>
        <rdfs:label xml:lang="bg">Има наблюдавано оперение</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasParentTaxon -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasParentTaxon">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Taxon"/>
        <rdfs:range rdf:resource="http://birds.ontology#Taxon"/>
        <rdfs:label xml:lang="en">Has parent taxon</rdfs:label>
        <rdfs:label xml:lang="bg">Има родителски таксон</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasPopulationTrend -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasPopulationTrend">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#PopulationTrend"/>
        <rdfs:label xml:lang="en">Has population trend</rdfs:label>
        <rdfs:label xml:lang="bg">Има популационна тенденция</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasTailMorphology -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasTailMorphology">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#TailMorphology"/>
        <rdfs:label xml:lang="en">Has tail morphology</rdfs:label>
        <rdfs:label xml:lang="bg">Има морфология на опашката</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasTypicalBehavior -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasTypicalBehavior">
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#Behavior"/>
        <rdfs:label xml:lang="en">Has typical behavior</rdfs:label>
        <rdfs:label xml:lang="bg">Има типично поведение</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasTypicalDiet -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasTypicalDiet">
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#Diet"/>
        <rdfs:label xml:lang="en">Has typical diet</rdfs:label>
        <rdfs:label xml:lang="bg">Има типична храна</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasTypicalHabitat -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasTypicalHabitat">
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#Habitat"/>
        <rdfs:label xml:lang="en">Has typical habitat</rdfs:label>
        <rdfs:label xml:lang="bg">Има типично местообитание</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasTypicalMeasurement -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasTypicalMeasurement">
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#Measurement"/>
        <rdfs:label xml:lang="en">Has typical measurement</rdfs:label>
        <rdfs:label xml:lang="bg">Има типично измерване</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasTypicalPlumagePattern -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasTypicalPlumagePattern">
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#PlumagePattern"/>
        <rdfs:label xml:lang="en">Has typical plumage pattern</rdfs:label>
        <rdfs:label xml:lang="bg">Има типично оперение</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasWeatherCondition -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasWeatherCondition">
        <rdfs:domain rdf:resource="http://birds.ontology#Observation"/>
        <rdfs:label xml:lang="en">Has weather condition</rdfs:label>
        <rdfs:label xml:lang="bg">Има метеорологично условие</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#hasWingMorphology -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#hasWingMorphology">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#WingMorphology"/>
        <rdfs:label xml:lang="en">Has wing morphology</rdfs:label>
        <rdfs:label xml:lang="bg">Има морфология на крилата</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#isObservedAtLocation -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#isObservedAtLocation">
        <rdfs:domain rdf:resource="http://birds.ontology#Observation"/>
        <rdfs:range rdf:resource="http://birds.ontology#Location"/>
        <rdfs:label xml:lang="en">Is observed at location</rdfs:label>
        <rdfs:label xml:lang="bg">Наблюдавано е на локация</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#isSpeciesOf -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#isSpeciesOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://birds.ontology#Bird"/>
        <rdfs:label xml:lang="en">Is species of</rdfs:label>
        <rdfs:label xml:lang="bg">Е вид на</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://birds.ontology#observedBird -->

    <owl:ObjectProperty rdf:about="http://birds.ontology#observedBird">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Observation"/>
        <rdfs:range rdf:resource="http://birds.ontology#Bird"/>
        <rdfs:label xml:lang="en">Observed bird</rdfs:label>
        <rdfs:label xml:lang="bg">Наблюдавана птица</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://birds.ontology#hasImageUrl -->

    <owl:DatatypeProperty rdf:about="http://birds.ontology#hasImageUrl">
        <rdfs:domain rdf:resource="http://birds.ontology#Species"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="en">Has image URL</rdfs:label>
        <rdfs:label xml:lang="bg">Има URL на изображение</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://birds.ontology#hasMaxValue -->

    <owl:DatatypeProperty rdf:about="http://birds.ontology#hasMaxValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Measurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">Has maximum value</rdfs:label>
        <rdfs:label xml:lang="bg">Има максимална стойност</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://birds.ontology#hasMinValue -->

    <owl:DatatypeProperty rdf:about="http://birds.ontology#hasMinValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Measurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">Has minimum value</rdfs:label>
        <rdfs:label xml:lang="bg">Има минимална стойност</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://birds.ontology#hasValue -->

    <owl:DatatypeProperty rdf:about="http://birds.ontology#hasValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Measurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">Has value</rdfs:label>
        <rdfs:label xml:lang="bg">Има стойност</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://birds.ontology#observedOn -->

    <owl:DatatypeProperty rdf:about="http://birds.ontology#observedOn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://birds.ontology#Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">Observed on</rdfs:label>
        <rdfs:label xml:lang="bg">Наблюдавано на</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://birds.ontology#ArachnivorousSpecies -->

    <owl:Class rdf:about="http://birds.ontology#ArachnivorousSpecies">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://birds.ontology#Species"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://birds.ontology#hasTypicalDiet"/>
                        <owl:hasValue rdf:resource="http://birds.ontology#Spiders"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://birds.ontology#Species"/>
        <rdfs:label xml:lang="en">Arachnivorous species</rdfs:label>
        <rdfs:label xml:lang="bg">Паякоядни видове</rdfs:label>
    </owl:Class>
    


    <!-- http://birds.ontology#BeakMorphology -->

    <owl:Class rdf:about="http://birds.ontology#BeakMorphology">
        <rdfs:subClassOf rdf:resource="http://birds.ontology#Morphology"/>
        <rdfs:label xml:lang="en">Beak morphology</rdfs:label>
        <rdfs:label xml:lang="bg">Морфология на клюна</rdfs:label>
    </owl:Class>
    


    <!-- http://birds.ontology#Behavior -->

    <owl:Class rdf:about="http://birds.ontology#Behavior">
        <rdfs:label xml:lang="en">Behavior</rdfs:label>
        <rdfs:label xml:lang="bg">Поведение</rdfs:label>
    </owl:Class>
    


    <!-- http://birds.ontology#Bird -->

    <owl:Class rdf:about="http://birds.ontology#Bird">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://birds.ontology#belongsToSpecies"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://birds.ontology#Species"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://birds.ontology#hasGender"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://birds.ontology#Gender"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://birds.ontology#hasLifeStage"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://birds.ontology#LifeStage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Bird</rdfs:label>
        <rdfs:label xml:lang="bg">Птица</rdfs:label>
    </owl:Class>
    


    <!-- http://birds.ontology#BlackWhiteSpecies -->

    <owl:Class rdf:about="http://birds.ontology#BlackWhiteSpecies">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://birds.ontology#Species"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://birds.ontology#hasTypicalPlumagePattern"/>
                        <owl:hasValue rdf:resource="http://birds.ontology#BlackWhitePlumage"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://birds.ontology#Species"/>
        <rdfs:label xml:lang="en">Black and white species</rdfs:label>
        <rdfs:label xml:lang="bg">Видове с черно-бяло оперение</rdfs:label>
    </owl:Class>
    


    <!-- http://birds.ontology#CarnivorousSpecies -->

    <owl:Class rdf:about="http://birds.ontology#CarnivorousSpecies">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://birds.ontology#Species"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://birds.ontology#hasTypicalDiet"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://birds.ontology#InsectLarvae"/>
                                    <rdf:Description rdf:about="http://birds.ontology#Insects"/>
                                </owl:oneOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://birds.ontology#Species"/>
        <rdfs:label xml:lang="en">Carnivorous species</rdfs:label>
        <rdfs:label xml:lang="bg">Месоядни видове</rdfs:label>
    </owl:Class>
    


    <!-- http://birds.ontology#ConiferousForestSpecies -->

    <owl:Class rdf:about="http://birds.ontology#ConiferousForestSpecies">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://birds.ontology#Species"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://birds.ontology#hasTypicalHabitat"/>
                        <owl:hasValue rdf:resource="http://birds.ontology#ConiferousForest"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://birds.ontology#Species"/>
        <rdfs:label xml:lang="en">Coniferous forest species</rdfs:label>
        <rdfs:label xml:lang="bg">Видове от иглолистни гори</rdfs:label>
    </owl:Class>
    


    <!-- http://birds.ontology#DeciduousForestSpecies -->

    <owl:Class rdf:about="http://birds.ontology#DeciduousForestSpecies">
