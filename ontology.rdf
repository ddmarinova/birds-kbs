                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://birds.ontology#hasIUCNStatus"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://birds.ontology#CR"/>
                                    <rdf:Description rdf:about="http://birds.ontology#EN"/>
                                    <rdf:Description rdf:about="http://birds.ontology#VU"/>
                                </owl:oneOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://birds.ontology#Species"/>
        <rdfs:label xml:lang="en">Threatened species</rdfs:label>
        <rdfs:label xml:lang="bg">Застрашени видове</rdfs:label>
    </owl:Class>
    


    <!-- http://birds.ontology#UrbanSpecies -->

    <owl:Class rdf:about="http://birds.ontology#UrbanSpecies">
